- content_for :header_day do
  .header-day{"data-day" => "#{@today.day}", "data-month" => "#{l(@today, format: :month)}"}
    = @today.day
    %p.header-month= l(@today, format: :month)

- content_for :header_year do
  %section{data: {controller: 'years', years_list: @years.to_a.sort.to_json}}
    .d-flex.justify-content-center
      .header-year(data-years-target="prev" data-action="click->years#prev") ◀
      %h3.header-year(data-years-target="curr")= @year
      .header-year(data-years-target="next" data-action="click->years#next") ▶
    .text-center.mt-n3
      = link_to 'Go!', year_path(@year), data: {years_target: 'link'}

.row
  - (1..12).each do |month|
    = cell(:month, nil, year: @year, month: month, today: @today, events: @events, show_desc: current_user&.can_see_description)

- if current_user&.can_see_legend
  .row.legend.mb-3(data-controller="activities")
    .col
      - @activities.each do |i|
        - next if i.count_during_year(@year).zero?
        %label
          %span{class: 'badge mr-1', style: "background: #{i.color}"}= ' '
          %input{type: "checkbox", data: {activity_id: i.id, action: 'activities#update'}}
          = i.name
        %br

    .vr.mr-5

    .col
      - @activities_group.each do |activities, times|
        %strong= "#{activities}:"
        = times
        %br

    .vr.mr-5

    .col.d-none{data: {activities_target: 'totalRow'}}
      %strong Total combined:
      %span{data: {activities_target: 'combined'}}
      %br
      %strong Total unique days:
      %span{data: {activities_target: 'unique'}}

- content_for :footer do
  - if current_user&.can_download
    = link_to "↯ Export #{@year} events as .csv", "#@year.csv"
